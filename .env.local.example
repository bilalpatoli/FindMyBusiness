# EnformionGo API credentials.
# Get these from the EnformionGo dashboard. Never commit the real values.
# .env.local is gitignored by default in Next.js.

# Use the production host once you're off dev: https://api.enformion.com
ENFORMION_BASE_URL=https://devapi.enformion.com

# Your Access Profile name and password from EnformionGo.
ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=
