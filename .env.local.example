# EnformionGo API credentials.
# Get these from the EnformionGo dashboard. Never commit the real values.
# .env.local is gitignored by default in Next.js.

# Use the production host once you're off dev: https://api.enformion.com
ENFORMION_BASE_URL=https://devapi.enformion.com

# Your Access Profile name and password from EnformionGo.
ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=

# Anthropic API key — enables Claude-based CSV column auto-detection on bulk
# upload. Without it, the bulk uploader falls back to a hardcoded list of
# header synonyms (businessName/name/company/title for the name column,
# state/st for the state column). Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# Clerk auth — required, the app won't load without these. Get both keys from
# the Clerk dashboard (https://dashboard.clerk.com/) under API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
